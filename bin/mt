    fi
    
    run_python_script "plaudDecryptor.py" "$@"
}

# GitHub PR 相关函数

# 获取 GitHub token
get_github_token() {
    # 优先从 github.token 文件获取
    local token_file="${PROJECT_ROOT}/github.token"
    if [[ -f "$token_file" ]]; then
        local token=$(cat "$token_file" 2>/dev/null | tr -d '\n' | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        if [[ -n "$token" ]]; then
            echo "$token"
            return 0
        fi
    fi
    
    # 其次从环境变量获取
    if [[ -n "${GITHUB_TOKEN:-}" ]]; then
        echo "$GITHUB_TOKEN"
        return 0
    fi
    
    # 最后从配置文件获取（向后兼容）
    local config_file="${PROJECT_ROOT}/.mt-config.yaml"
    if [[ -f "$config_file" ]]; then
        local token=$(grep -E "^github_token:" "$config_file" 2>/dev/null | sed -E 's/^[[:space:]]*github_token:[[:space:]]*(.*)$/\1/' | tr -d '"' | tr -d "'")
        if [[ -n "$token" ]]; then
            echo "$token"
            return 0
        fi
    fi
    
    return 1
}

# 从 git remote 获取仓库信息
get_repo_info() {
    local repo_path="$1"
    local remote_url
    
    # 支持普通仓库和 Submodule
    if [[ ! -d "${repo_path}/.git" ]] && [[ ! -f "${repo_path}/.git" ]]; then
        return 1
    fi
    
    # 获取 origin remote URL
    remote_url=$(cd "$repo_path" && git remote get-url origin 2>/dev/null || echo "")
    
    if [[ -z "$remote_url" ]]; then
        return 1
    fi
    
    # 解析仓库信息
    # 支持 git@github.com:org/repo.git 和 https://github.com/org/repo.git
    if [[ "$remote_url" =~ git@github\.com:(.+)\.git$ ]]; then
        echo "${BASH_REMATCH[1]}"
    elif [[ "$remote_url" =~ https://github\.com/(.+)\.git$ ]]; then
        echo "${BASH_REMATCH[1]}"
    elif [[ "$remote_url" =~ https://github\.com/(.+)$ ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        return 1
    fi
}

# 从 GitHub API JSON 响应中提取第一个 html_url
# 兼容对象/数组、以及 `"html_url": "..."`（含空格）的格式
extract_first_html_url() {
    if command -v python3 >/dev/null 2>&1; then
        python3 -c '
import sys, json
s = sys.stdin.read()
try:
    data = json.loads(s)
except Exception:
    sys.exit(0)
def find(x):
    if isinstance(x, dict):
        v = x.get("html_url")
        if isinstance(v, str) and v:
            return v
        for vv in x.values():
            r = find(vv)
            if r:
                return r
    elif isinstance(x, list):
        for i in x:
            r = find(i)
            if r:
                return r
    return None
r = find(data)
if r:
    sys.stdout.write(r)
' 2>/dev/null
        return 0
    fi
    
    # fallback: sed 提取（兼容空格）
    sed -nE 's/.*"html_url"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' | head -n 1
}

# 从 GitHub API JSON 响应中提取 PR number
extract_pr_number() {
    if command -v python3 >/dev/null 2>&1; then
        python3 -c '
import sys, json
s = sys.stdin.read()
try:
    data = json.loads(s)
except Exception:
    sys.exit(0)
if isinstance(data, dict):
    n = data.get("number")
    if isinstance(n, int):
        sys.stdout.write(str(n))
' 2>/dev/null
        return 0
    fi
    
    sed -nE 's/.*"number"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' | head -n 1
}

# 为 PR 添加 label（仅用于新建 PR）
add_label_to_pr() {
    local repo_full_name="$1"
    local pr_number="$2"
    local label_name="$3"
    local github_token="$4"
    
    if [[ -z "$repo_full_name" ]] || [[ -z "$pr_number" ]] || [[ -z "$label_name" ]] || [[ -z "$github_token" ]]; then
        return 1
    fi
    
    local api_url="https://api.github.com/repos/${repo_full_name}/issues/${pr_number}/labels"
    local json_data
    json_data=$(cat <<EOF
{
  "labels": ["${label_name}"]
}
EOF
)
    
    local response
    response=$(curl -s -w "\n%{http_code}" -X POST "$api_url" \
        -H "Accept: application/vnd.github.v3+json" \
        -H "Authorization: token ${github_token}" \
        -H "Content-Type: application/json" \
        -d "$json_data" 2>/dev/null || true)
    
    local http_code
    http_code=$(echo "$response" | tail -n1)
    
    if [[ "$http_code" =~ ^20[0-9]$ ]]; then
        return 0
    fi
    
    return 1
}

# 确保 label 存在（不存在则创建）
ensure_label_exists() {
    local repo_full_name="$1"
    local label_name="$2"
    local github_token="$3"
    local label_color="${4:-1D76DB}"
    
    if [[ -z "$repo_full_name" ]] || [[ -z "$label_name" ]] || [[ -z "$github_token" ]]; then
        return 1
    fi
    
    local api_url="https://api.github.com/repos/${repo_full_name}/labels"
    local json_data
    json_data=$(cat <<EOF
{
  "name": "${label_name}",
  "color": "${label_color}",
  "description": "Created by mt pr"
}
EOF
)
    
    local response
    response=$(curl -s -w "\n%{http_code}" -X POST "$api_url" \
        -H "Accept: application/vnd.github.v3+json" \
        -H "Authorization: token ${github_token}" \
        -H "Content-Type: application/json" \
        -d "$json_data" 2>/dev/null || true)
    
    local http_code
    http_code=$(echo "$response" | tail -n1)
    
    # 201: created, 422: already exists (validation failed)
    if [[ "$http_code" == "201" ]] || [[ "$http_code" == "422" ]]; then
        return 0
    fi
    
    return 1
}

# 请求 Copilot 作为 PR reviewer（仅用于新建 PR）
request_copilot_review() {
    local repo_full_name="$1"
    local pr_number="$2"
    local github_token="$3"
    
    if [[ -z "$repo_full_name" ]] || [[ -z "$pr_number" ]] || [[ -z "$github_token" ]]; then
        return 1
    fi
    
    local api_url="https://api.github.com/repos/${repo_full_name}/pulls/${pr_number}/requested_reviewers"
    
    # 默认使用 copilot，可通过环境变量覆盖
    local reviewer_login="${MT_COPILOT_REVIEWER:-copilot}"
    local candidates=("$reviewer_login" "github-copilot[bot]" "Copilot")
    
    for reviewer_login in "${candidates[@]}"; do
        # 跳过空值
        if [[ -z "$reviewer_login" ]]; then
            continue
        fi
        
        local json_data
        json_data=$(cat <<EOF
{
  "reviewers": ["${reviewer_login}"]
}
EOF
)
        
        local response
        response=$(curl -s -w "\n%{http_code}" -X POST "$api_url" \
            -H "Accept: application/vnd.github.v3+json" \
            -H "Authorization: token ${github_token}" \
            -H "Content-Type: application/json" \
            -d "$json_data" 2>/dev/null || true)
        
        local http_code
        http_code=$(echo "$response" | tail -n1)
        
        if [[ "$http_code" =~ ^20[0-9]$ ]]; then
            return 0
        fi
    done
    
    return 1
}

# 获取已存在的 PR URL（仅检查 open 状态）
# 参数: repo_full_name(org/repo), source_branch, target_branch, github_token
get_existing_pr_url() {
    local repo_full_name="$1"
    local source_branch="$2"
    local target_branch="$3"
    local github_token="$4"
    
    if [[ -z "$repo_full_name" ]] || [[ -z "$source_branch" ]] || [[ -z "$target_branch" ]] || [[ -z "$github_token" ]]; then
        return 1
    fi
    
    local api_url="https://api.github.com/repos/${repo_full_name}/pulls"
    
    # GitHub pulls API 的 head 参数格式为 "owner:branch"
    # 注意：branch 名称可能包含 "/"（例如 feature/xxx），不能误判为 owner/branch
    local repo_owner="${repo_full_name%%/*}"
    
    # 尝试多种 head 参数格式，以兼容：
    # - 同仓库分支: repoOwner:branch
    # - 某些团队约定的 "user/branch"（PR head 来自 fork）: user:branch
    local head_candidates=()
    if [[ "$source_branch" == *":"* ]]; then
        head_candidates+=("$source_branch")
    else
        head_candidates+=("${repo_owner}:${source_branch}")
        if [[ "$source_branch" == */* ]]; then
            local maybe_owner="${source_branch%%/*}"
            local maybe_branch="${source_branch#*/}"
            head_candidates+=("${maybe_owner}:${maybe_branch}")
        fi
    fi
    
    local pr_url=""
    local prs=""
    local state=""
    local head_param=""
    
    for head_param in "${head_candidates[@]}"; do
        # 1) 先尝试精确匹配：head + base（open）
        if [[ -n "$target_branch" ]]; then
            prs=$(curl -s -G "$api_url" \
                --data-urlencode "head=${head_param}" \
                --data-urlencode "base=${target_branch}" \
                --data-urlencode "state=open" \
                --data-urlencode "per_page=1" \
                -H "Accept: application/vnd.github.v3+json" \
                -H "Authorization: token ${github_token}" 2>/dev/null)
            pr_url=$(echo "$prs" | extract_first_html_url)
            if [[ -n "$pr_url" ]]; then
                echo "$pr_url"
                return 0
            fi
        fi
        
        # 2) 再尝试宽松匹配：仅 head（open）
        prs=$(curl -s -G "$api_url" \
            --data-urlencode "head=${head_param}" \
            --data-urlencode "state=open" \
            --data-urlencode "per_page=1" \
            -H "Accept: application/vnd.github.v3+json" \
            -H "Authorization: token ${github_token}" 2>/dev/null)
        pr_url=$(echo "$prs" | extract_first_html_url)
        if [[ -n "$pr_url" ]]; then
            echo "$pr_url"
            return 0
        fi
    done
    
    # open 未命中，再尝试 all（兼容某些情况下 API 提示已存在但 base 不一致/状态特殊）
    for head_param in "${head_candidates[@]}"; do
        if [[ -n "$target_branch" ]]; then
            prs=$(curl -s -G "$api_url" \
                --data-urlencode "head=${head_param}" \
                --data-urlencode "base=${target_branch}" \
                --data-urlencode "state=all" \
                --data-urlencode "per_page=1" \
                -H "Accept: application/vnd.github.v3+json" \
                -H "Authorization: token ${github_token}" 2>/dev/null)
            pr_url=$(echo "$prs" | extract_first_html_url)
            if [[ -n "$pr_url" ]]; then
                echo "$pr_url"
                return 0
            fi
        fi
        
        prs=$(curl -s -G "$api_url" \
            --data-urlencode "head=${head_param}" \
            --data-urlencode "state=all" \
            --data-urlencode "per_page=1" \
            -H "Accept: application/vnd.github.v3+json" \
            -H "Authorization: token ${github_token}" 2>/dev/null)
        pr_url=$(echo "$prs" | extract_first_html_url)
        if [[ -n "$pr_url" ]]; then
            echo "$pr_url"
            return 0
        fi
    done
    
    return 1
}

# 获取当前分支
get_current_branch() {
    local repo_path="$1"
    (cd "$repo_path" && git rev-parse --abbrev-ref HEAD 2>/dev/null) || return 1
}

# 获取最新的 commit message
get_latest_commit_message() {
    local repo_path="$1"
    (cd "$repo_path" && git log -1 --pretty=%B 2>/dev/null | head -1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//') || return 1
}

# 检查仓库相对于目标分支是否有修改（用于 PR）
check_repo_has_changes_for_pr() {
    local repo_path="$1"
    local target_branch="$2"
    
    if [[ ! -d "${repo_path}/.git" ]] && [[ ! -f "${repo_path}/.git" ]]; then
        return 1  # 不是 Git 仓库
    fi
    
    # 获取当前分支
    local current_branch=$(cd "$repo_path" && git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [[ -z "$current_branch" ]]; then
        return 1  # 没有分支
    fi
    
    # 如果当前分支就是目标分支，没有修改
    if [[ "$current_branch" == "$target_branch" ]]; then
        return 1
    fi
    
    # 先获取远程分支信息（静默执行）
    (cd "$repo_path" && git fetch origin "$target_branch" "$current_branch" 2>/dev/null || true)
    
    # 检查远程分支是否存在
    local remote_branch_exists
    remote_branch_exists=$(cd "$repo_path" && git ls-remote --heads origin "$current_branch" 2>/dev/null | grep -q "$current_branch" && echo "yes" || echo "no")
    if [[ "$remote_branch_exists" == "no" ]]; then
        return 1  # 分支未推送，无法比较
    fi
    
    # 检查是否有共同历史（使用远程分支）
    local common_base
    common_base=$(cd "$repo_path" && git merge-base "origin/${target_branch}" "origin/${current_branch}" 2>/dev/null || echo "")
    if [[ -z "$common_base" ]]; then
        return 1  # 没有共同历史，无法比较
    fi
    
    # 检查远程分支和目标分支是否有实际的代码差异
    # 使用 git diff 检查是否有任何文件变更
    local has_diff
    has_diff=$(cd "$repo_path" && git diff --quiet "origin/${target_branch}..origin/${current_branch}" 2>/dev/null && echo "no" || echo "yes")
    
    if [[ "$has_diff" == "no" ]]; then
        return 1  # 没有代码差异，不需要创建 PR
    fi
    
    # 有代码差异，需要创建 PR
    return 0
}

# 创建 GitHub PR
create_github_pr() {
    local repo_path="$1"
    local repo_info="$2"
    local source_branch="$3"
    local target_branch="${4:-main}"
    local title="$5"
    local description="$6"
    local github_token="$7"
    
    # 错误输出重定向到 stderr，避免被捕获
    local error_output=""
    
    IFS='|' read -r name path url <<< "$repo_info"
    
    # 获取仓库信息
    local repo_full_name
    repo_full_name=$(get_repo_info "$repo_path")
    if [[ -z "$repo_full_name" ]]; then
        echo -e "${BOLD_RED}错误: 无法获取仓库信息: ${path}${NC}"
        return 1
    fi
    
    # 静默获取远程分支信息
    (cd "$repo_path" && git fetch origin "$target_branch" "$source_branch" 2>/dev/null || true)
    
    # 检查分支是否已推送到远程
    local branch_exists
    branch_exists=$(cd "$repo_path" && git ls-remote --heads origin "$source_branch" 2>/dev/null | grep -q "$source_branch" && echo "yes" || echo "no")
    if [[ "$branch_exists" == "no" ]]; then
        echo -e "${BOLD_YELLOW}警告: 分支 ${source_branch} 不存在于远程${NC}" >&2
        echo -e "${YELLOW}请先推送分支: git push origin ${source_branch}${NC}" >&2
        return 1
    fi
    
    # 若 PR 已存在（open），直接返回 URL
    local existing_pr_url
    existing_pr_url=$(get_existing_pr_url "$repo_full_name" "$source_branch" "$target_branch" "$github_token" 2>/dev/null || echo "")
    if [[ -n "$existing_pr_url" ]]; then
        echo "$existing_pr_url"
        return 0
    fi
    
    # 检查分支和目标分支是否有共同历史（使用远程分支）
    local common_base
    common_base=$(cd "$repo_path" && git merge-base "origin/${target_branch}" "origin/${source_branch}" 2>/dev/null || echo "")
    if [[ -z "$common_base" ]]; then
        echo -e "${BOLD_YELLOW}警告: 分支 ${source_branch} 和 ${target_branch} 没有共同历史${NC}" >&2
        echo -e "${YELLOW}这可能是因为分支是从不同的提交创建的${NC}" >&2
        echo -e "${YELLOW}解决方案:${NC}" >&2
        echo -e "${CYAN}  1. 确保分支是从 ${target_branch} 创建的${NC}" >&2
        echo -e "${CYAN}  2. 或者先合并 ${target_branch} 到 ${source_branch}:${NC}" >&2
        echo -e "${CYAN}     git checkout ${source_branch}${NC}" >&2
        echo -e "${CYAN}     git merge origin/${target_branch}${NC}" >&2
        echo -e "${CYAN}     git push origin ${source_branch}${NC}" >&2
        return 1
    fi
    
    # 检查是否有 push 冲突（远程目标分支有新的提交，可能导致冲突）
    # 注意：这只是警告，不会阻止创建 PR，静默检查，只在真正创建时显示
    
    # 检查当前分支是否领先于目标分支（有新的提交）
    local ahead
    ahead=$(cd "$repo_path" && git rev-list --count "${common_base}..origin/${source_branch}" 2>/dev/null || echo "0")
    if [[ "$ahead" -eq 0 ]]; then
        echo -e "${BOLD_YELLOW}警告: 分支 ${source_branch} 没有相对于 ${target_branch} 的新提交${NC}" >&2
        return 1
    fi
    
    # 转义 JSON 特殊字符
    local title_escaped=$(echo "$title" | sed 's/"/\\"/g' | sed 's/$/\\n/' | tr -d '\n' | sed 's/\\n$//')
    local desc_escaped=$(echo "$description" | sed 's/"/\\"/g' | sed 's/$/\\n/' | tr -d '\n' | sed 's/\\n$//')
    
    # 创建 PR
    local api_url="https://api.github.com/repos/${repo_full_name}/pulls"
    local json_data=$(cat <<EOF
{
  "title": "${title_escaped}",
  "body": "${desc_escaped}",
  "head": "${source_branch}",
  "base": "${target_branch}",
  "draft": true
}
EOF
)
    
    # 静默创建 PR（不打印详细命令信息）
    
    local response
    response=$(curl -s -w "\n%{http_code}" -X POST "$api_url" \
        -H "Accept: application/vnd.github.v3+json" \
        -H "Authorization: token ${github_token}" \
        -H "Content-Type: application/json" \
        -d "$json_data" 2>&1)
    
    local http_code=$(echo "$response" | tail -n1)
    local body=$(echo "$response" | sed '$d')
    
    if [[ "$http_code" == "201" ]]; then
        local pr_url
        pr_url=$(echo "$body" | extract_first_html_url)
        local pr_number
        pr_number=$(echo "$body" | extract_pr_number)
        
        # 仅对新建 PR 设置 label/reviewer（已存在 PR 不修改）
        if [[ -n "$pr_number" ]]; then
            local auto_label="MT AUTO"
            
            # 先尝试直接加 label；失败再创建 label 并重试一次
            if ! add_label_to_pr "$repo_full_name" "$pr_number" "$auto_label" "$github_token"; then
                if ensure_label_exists "$repo_full_name" "$auto_label" "$github_token" "1D76DB"; then
                    add_label_to_pr "$repo_full_name" "$pr_number" "$auto_label" "$github_token" || true
                fi
            fi
            
            # 请求 Copilot 进行 code review（最佳努力）
            request_copilot_review "$repo_full_name" "$pr_number" "$github_token" || true
        fi
        
        echo "$pr_url"
        return 0
    elif [[ "$http_code" == "422" ]]; then
        # 检查是否已存在 PR（多种错误消息格式）
        if echo "$body" | grep -q "already exists" || echo "$body" | grep -q "A pull request already exists"; then
            # PR 已存在（open），查询并返回 URL
            local existing_pr_url=""
            existing_pr_url=$(get_existing_pr_url "$repo_full_name" "$source_branch" "$target_branch" "$github_token" 2>/dev/null || echo "")
            
            if [[ -n "$existing_pr_url" ]]; then
                echo "$existing_pr_url"
                return 0
            else
                # PR 已存在但无法获取 URL，简单提示
                echo "PR_EXISTS"
                return 0
            fi
        fi
        
        echo -e "${BOLD_RED}错误: 创建 PR 失败 (HTTP ${http_code})${NC}" >&2
        IFS='|' read -r name path url <<< "$repo_info"
        echo -e "${RED}仓库: ${name}${NC}" >&2
        
        # 解析错误信息，提供更友好的提示
        if echo "$body" | grep -q "no history in common"; then
            echo -e "${YELLOW}原因: 分支 ${source_branch} 和 ${target_branch} 没有共同历史${NC}" >&2
            echo -e "${YELLOW}解决方案:${NC}" >&2
            echo -e "${CYAN}  1. 确保分支已推送到远程: git push origin ${source_branch}${NC}" >&2
            echo -e "${CYAN}  2. 如果分支是从其他分支创建的，需要先合并 ${target_branch}:${NC}" >&2
            echo -e "${CYAN}     git checkout ${source_branch}${NC}" >&2
            echo -e "${CYAN}     git merge ${target_branch}${NC}" >&2
            echo -e "${CYAN}     git push origin ${source_branch}${NC}" >&2
        elif echo "$body" | grep -q "Validation Failed"; then
            echo -e "${YELLOW}GitHub API 验证失败:${NC}" >&2
            # 提取错误消息
            local error_msg=$(echo "$body" | grep -o '"message":"[^"]*"' | head -1 | cut -d'"' -f4)
            if [[ -n "$error_msg" ]]; then
                echo -e "${RED}  错误消息: ${error_msg}${NC}" >&2
            fi
            # 提取详细的错误信息
            local errors=$(echo "$body" | grep -o '"errors":\[[^\]]*\]' | head -1)
            if [[ -n "$errors" ]]; then
                echo -e "${YELLOW}  详细错误:${NC}" >&2
                echo -e "${RED}  ${errors}${NC}" >&2
            fi
            # 显示完整的响应体（用于调试）
            echo -e "${YELLOW}  完整响应:${NC}" >&2
            echo -e "${CYAN}  ${body}${NC}" >&2
        else
            echo -e "${YELLOW}错误详情:${NC}" >&2
            echo -e "${RED}  ${body}${NC}" >&2
        fi
        return 1
    else
        # 处理其他 HTTP 状态码
        echo -e "${BOLD_RED}错误: 创建 PR 失败 (HTTP ${http_code})${NC}" >&2
        IFS='|' read -r name path url <<< "$repo_info"
        echo -e "${RED}仓库: ${name}${NC}" >&2
        
        # 根据不同的 HTTP 状态码提供不同的错误信息
        case "$http_code" in
            401)
                echo -e "${YELLOW}原因: 未授权，GitHub token 无效或已过期${NC}" >&2
                echo -e "${YELLOW}解决方案:${NC}" >&2
                echo -e "${CYAN}  请使用 'mt set-github-token <your_token>' 重新设置 token${NC}" >&2
                echo -e "${CYAN}  获取新 token: https://github.com/settings/tokens${NC}" >&2
                ;;
            403)
                echo -e "${YELLOW}原因: 禁止访问，可能是 token 权限不足或仓库访问受限${NC}" >&2
                echo -e "${YELLOW}解决方案:${NC}" >&2
                echo -e "${CYAN}  1. 检查 token 是否有 'repo' 权限${NC}" >&2
                echo -e "${CYAN}  2. 确认你有该仓库的访问权限${NC}" >&2
                ;;
            404)
                echo -e "${YELLOW}原因: 仓库或分支不存在${NC}" >&2
                echo -e "${YELLOW}解决方案:${NC}" >&2
                echo -e "${CYAN}  1. 确认仓库路径正确: ${repo_full_name}${NC}" >&2
                echo -e "${CYAN}  2. 确认分支已推送到远程: git push origin ${source_branch}${NC}" >&2
                ;;
            500|502|503|504)
                echo -e "${YELLOW}原因: GitHub 服务器错误 (HTTP ${http_code})${NC}" >&2
                echo -e "${YELLOW}解决方案:${NC}" >&2
                echo -e "${CYAN}  请稍后重试${NC}" >&2
                ;;
            *)
                echo -e "${YELLOW}未知错误 (HTTP ${http_code})${NC}" >&2
                ;;
        esac
        
        # 显示响应体（如果有）
        if [[ -n "$body" ]]; then
            echo -e "${YELLOW}响应内容:${NC}" >&2
            # 尝试提取错误消息
            local error_msg=$(echo "$body" | grep -o '"message":"[^"]*"' | head -1 | cut -d'"' -f4)
            if [[ -n "$error_msg" ]]; then
                echo -e "${RED}  ${error_msg}${NC}" >&2
            else
                echo -e "${CYAN}  ${body}${NC}" >&2
            fi
        fi
        
        return 1
    fi
}

# 更新 PR 描述
update_pr_description() {
    local repo_path="$1"
    local repo_info="$2"
    local pr_url="$3"
    local new_description="$4"
    local github_token="$5"
    
    IFS='|' read -r name path url <<< "$repo_info"
    
    # 获取仓库信息
    local repo_full_name
    repo_full_name=$(get_repo_info "$repo_path")
    if [[ -z "$repo_full_name" ]]; then
        return 1
    fi
    
    # 从 PR URL 提取 PR 号
    local pr_number
    pr_number=$(echo "$pr_url" | grep -oE '/pull/[0-9]+' | grep -oE '[0-9]+')
    if [[ -z "$pr_number" ]]; then
        return 1
    fi
    
    # 转义 JSON 特殊字符
    local desc_escaped=$(echo "$new_description" | sed 's/"/\\"/g' | sed 's/$/\\n/' | tr -d '\n' | sed 's/\\n$//')
    
    # 更新 PR
    local api_url="https://api.github.com/repos/${repo_full_name}/pulls/${pr_number}"
    local json_data=$(cat <<EOF
{
  "body": "${desc_escaped}"
}
EOF
)
    
    # 打印执行的命令
    echo -e "${CYAN}更新 PR 描述...${NC}"
    echo -e "${CYAN}  → curl -X PATCH ${api_url}${NC}"
    echo -e "${CYAN}  → Head: Authorization: token ***${NC}"
    
    local response
    response=$(curl -s -w "\n%{http_code}" -X PATCH "$api_url" \
        -H "Accept: application/vnd.github.v3+json" \
        -H "Authorization: token ${github_token}" \
        -H "Content-Type: application/json" \
        -d "$json_data" 2>&1)
    
    local http_code=$(echo "$response" | tail -n1)
    
    if [[ "$http_code" == "200" ]]; then
        return 0
    else
        return 1
    fi
}

# 创建多个仓库的 PR 并关联
create_prs() {
    local target_branch="${1:-main}"
    local title="${2:-}"
    local description="${3:-}"
    
    # 检查 GitHub token
    local github_token
    github_token=$(get_github_token 2>&1)
    local token_exit_code=$?
    if [[ $token_exit_code -ne 0 ]] || [[ -z "$github_token" ]]; then
        echo -e "${BOLD_RED}错误: 未找到 GitHub token${NC}" >&2
        echo -e "${YELLOW}请使用以下命令设置 GitHub token:${NC}" >&2
        echo -e "${CYAN}  mt set-github-token <your_token>${NC}" >&2
        echo -e "${YELLOW}Token 将保存到 github.token 文件（已添加到 .gitignore）${NC}" >&2
        echo -e "${CYAN}获取 token: https://github.com/settings/tokens${NC}" >&2
        return 1
    fi
    
    check_config
    
    # 获取仓库列表
    local repos_array
    read -ra repos_array <<< "$(get_repositories)"
    
    if [[ ${#repos_array[@]} -eq 0 ]]; then
        echo -e "${BOLD_RED}错误: 未找到任何仓库配置${NC}"
        exit 1
    fi
    
    echo -e "${BLUE}========================================${NC}"
    echo -e "${BLUE}  创建 GitHub Pull Request${NC}"
    echo -e "${BLUE}========================================${NC}"
    echo -e "${CYAN}目标分支: ${target_branch}${NC}"
    echo ""
    
    # 收集所有 PR URL 和状态（使用普通数组，因为 macOS bash 可能不支持关联数组）
    local pr_urls_names=()
    local pr_urls_values=()
    local pr_status_names=()
    local pr_status_values=()
    local total=${#repos_array[@]}
    local success_count=0
    local skipped_count=0
    
    # 第一遍：创建所有 PR
    for i in "${!repos_array[@]}"; do
        local repo_info="${repos_array[$i]}"
        IFS='|' read -r name path url <<< "$repo_info"
        
        local repo_path="${PROJECT_ROOT}/${path}"
        local index=$((i + 1))
        
        echo -e "${CYAN}[${index}/${total}] ${name}${NC}"
        
        # 检查路径是否存在
        if [[ ! -d "$repo_path" ]]; then
            echo -e "${YELLOW}  ⏭  跳过: 路径不存在 ${path}${NC}"
            pr_status_names+=("$name")
            pr_status_values+=("路径不存在")
            continue
        fi
        
        # 获取当前分支
        local current_branch
        current_branch=$(get_current_branch "$repo_path")
        if [[ -z "$current_branch" ]]; then
            echo -e "${YELLOW}  ⏭  跳过: 无法获取当前分支${NC}"
            pr_status_names+=("$name")
            pr_status_values+=("无法获取分支")
            continue
        fi
        
        # 如果当前分支是目标分支，跳过
        if [[ "$current_branch" == "$target_branch" ]]; then
            echo -e "${YELLOW}  ⏭  跳过: 当前分支已是 ${target_branch}${NC}"
            pr_status_names+=("$name")
            pr_status_values+=("无代码变更")
            ((skipped_count++))
            continue
        fi
        
        # PR 只能基于「已提交并推送到远程」的提交创建：
        # 1) 若当前仓库存在未提交修改（工作区或暂存区），不要误报“无代码变更”
        local has_uncommitted_changes=false
        if ! (cd "$repo_path" && git diff --quiet 2>/dev/null); then
            has_uncommitted_changes=true
        fi
        if ! (cd "$repo_path" && git diff --cached --quiet 2>/dev/null); then
            has_uncommitted_changes=true
        fi
        if [[ "$has_uncommitted_changes" == true ]]; then
            echo -e "${YELLOW}  ⚠  检测到未提交的本地修改（PR 只基于已提交并推送到远程的提交）${NC}"
            echo -e "${YELLOW}  请先提交并推送后再执行 mt pr${NC}"
            echo -e "${CYAN}    git add . && git commit -m \"...\" && git push${NC}"
            pr_status_names+=("$name")
            pr_status_values+=("需要先提交")
            echo ""
            continue
        fi
        
        # 2) 若本地分支与远程分支不一致（常见于 amend/rebase 后未 push），不要误报“无代码变更”
        local local_sha=""
        local remote_sha=""
        local_sha=$(cd "$repo_path" && git rev-parse "$current_branch" 2>/dev/null || echo "")
        remote_sha=$(cd "$repo_path" && git rev-parse "origin/${current_branch}" 2>/dev/null || echo "")
        if [[ -n "$local_sha" ]] && [[ -n "$remote_sha" ]] && [[ "$local_sha" != "$remote_sha" ]]; then
            local ahead_count
            local behind_count
            ahead_count=$(cd "$repo_path" && git rev-list --count "origin/${current_branch}..${current_branch}" 2>/dev/null || echo "0")
            behind_count=$(cd "$repo_path" && git rev-list --count "${current_branch}..origin/${current_branch}" 2>/dev/null || echo "0")
            
            echo -e "${YELLOW}  ⚠  本地分支与远程分支不一致（PR 以远程分支为准）${NC}"
            
            if [[ "$ahead_count" -gt 0 ]] && [[ "$behind_count" -eq 0 ]]; then
                echo -e "${YELLOW}  本地领先 ${ahead_count} 个提交，请先推送:${NC}"
                echo -e "${CYAN}    git push origin ${current_branch}${NC}"
                pr_status_names+=("$name")
                pr_status_values+=("需要先推送")
            elif [[ "$ahead_count" -eq 0 ]] && [[ "$behind_count" -gt 0 ]]; then
                echo -e "${YELLOW}  本地落后远程 ${behind_count} 个提交，请先同步:${NC}"
                echo -e "${CYAN}    git pull --rebase${NC}"
                pr_status_names+=("$name")
                pr_status_values+=("需要先同步")
            elif [[ "$ahead_count" -gt 0 ]] && [[ "$behind_count" -gt 0 ]]; then
                echo -e "${YELLOW}  分支发生分叉（可能执行了 rebase/amend），请先推送（推荐 --force-with-lease）:${NC}"
                echo -e "${CYAN}    git push --force-with-lease origin ${current_branch}${NC}"
                pr_status_names+=("$name")
                pr_status_values+=("需要先推送")
            else
                echo -e "${YELLOW}  请先推送/同步后再创建 PR${NC}"
                pr_status_names+=("$name")
                pr_status_values+=("需要先推送")
            fi
            
            echo ""
            continue
        fi
        
        # 检查是否有相对于目标分支的修改
        # 先检查远程分支是否有修改
        local has_remote_changes=false
        if check_repo_has_changes_for_pr "$repo_path" "$target_branch"; then
            has_remote_changes=true
        fi
        
        # 如果远程没有修改，检查本地是否有未推送的提交
        if [[ "$has_remote_changes" == false ]]; then
            # 检查本地是否有未推送的提交和实际的代码变更
            (cd "$repo_path" && git fetch origin "$target_branch" "$current_branch" 2>/dev/null || true)
            local common_base
            common_base=$(cd "$repo_path" && git merge-base "origin/${target_branch}" "$current_branch" 2>/dev/null || echo "")
            
            # 无法计算 merge-base 时，不能误报“无代码变更”
            if [[ -z "$common_base" ]]; then
                echo -e "${BOLD_YELLOW}警告: 无法判断是否有相对于 ${target_branch} 的代码变更（merge-base 失败）${NC}"
                echo -e "${YELLOW}可能原因:${NC}"
                echo -e "${CYAN}  1) 目标分支名不正确或未拉取（请尝试 git fetch origin ${target_branch}）${NC}"
                echo -e "${CYAN}  2) 分支历史无共同祖先（需要检查分支来源）${NC}"
                pr_status_names+=("$name")
                pr_status_values+=("无法比较")
                echo ""
                continue
            fi
            
            # 检查本地分支和目标分支是否有实际的代码差异（基于提交快照）
            local has_local_diff
            has_local_diff=$(cd "$repo_path" && git diff --quiet "${common_base}..${current_branch}" 2>/dev/null && echo "no" || echo "yes")
            
            if [[ "$has_local_diff" == "yes" ]]; then
                # 本地有差异，但远程未检测到变化：通常意味着本地提交尚未推送到远程
                echo -e "${YELLOW}  ⚠  检测到本地有相对于 ${target_branch} 的提交差异，但远程分支未检测到变更${NC}"
                echo -e "${YELLOW}  PR 以远程分支为准，请先推送当前分支到远程后再创建 PR:${NC}"
                echo -e "${CYAN}    git push origin ${current_branch}${NC}"
                echo -e "${CYAN}    （如执行过 rebase/amend，推荐使用 --force-with-lease）${NC}"
                pr_status_names+=("$name")
                pr_status_values+=("需要先推送")
                echo ""
                continue
            fi
            
            # 本地也没有代码变更，才跳过
            echo -e "${YELLOW}  ⏭  跳过: 没有相对于 ${target_branch} 的代码变更${NC}"
            pr_status_names+=("$name")
            pr_status_values+=("无代码变更")
            ((skipped_count++))
            continue
        fi
        
        # 在创建 PR 前，检查是否有冲突（通过 create_github_pr 内部的检查）
        # 这里我们直接尝试创建，如果失败会在 create_github_pr 中处理
        
        # 生成 PR 标题和描述
        # 如果没有指定 title，使用最新的 commit message
        local pr_title="${title:-}"
        if [[ -z "$pr_title" ]]; then
            pr_title=$(get_latest_commit_message "$repo_path")
            if [[ -z "$pr_title" ]]; then
                pr_title="$current_branch"
            fi
        fi
        local pr_description="${description:-}"
        
        # 在创建 PR 前，先快速检查是否已存在 open PR（存在则直接返回 URL）
        local repo_full_name
        repo_full_name=$(get_repo_info "$repo_path")
        local existing_pr_url=""
        if [[ -n "$repo_full_name" ]]; then
            existing_pr_url=$(get_existing_pr_url "$repo_full_name" "$current_branch" "$target_branch" "$github_token" 2>/dev/null || echo "")
        fi
        
        # 如果已存在 PR，直接使用并跳过创建
        if [[ -n "$existing_pr_url" ]]; then
            pr_urls_names+=("$name")
            pr_urls_values+=("$existing_pr_url")
            pr_status_names+=("$name")
            pr_status_values+=("$existing_pr_url")
            ((success_count++))
            echo -e "${GREEN}  ${CHECK_MARK} PR 已存在${NC}"
            echo -e "${CYAN}    ${existing_pr_url}${NC}"
            echo ""
            continue
        else
            # 创建 PR（create_github_pr 内部也会检查已存在的 PR 和冲突）
            # 使用临时文件捕获 stderr，同时让 stdout 正常输出
            local temp_stderr=$(mktemp)
            local pr_url
            pr_url=$(create_github_pr "$repo_path" "$repo_info" "$current_branch" "$target_branch" "$pr_title" "$pr_description" "$github_token" 2>"$temp_stderr")
            local pr_exit_code=$?
            local pr_error_output=$(cat "$temp_stderr" 2>/dev/null)
            rm -f "$temp_stderr"
            
            # 如果有错误输出，显示它
            if [[ -n "$pr_error_output" ]]; then
                echo "$pr_error_output" >&2
            fi
            
            if [[ -n "$pr_url" ]] && echo "$pr_url" | grep -q "github.com" && [[ "$pr_exit_code" -eq 0 ]]; then
                pr_urls_names+=("$name")
                pr_urls_values+=("$pr_url")
                pr_status_names+=("$name")
                pr_status_values+=("$pr_url")
                ((success_count++))
                echo -e "${GREEN}  ${CHECK_MARK} PR 创建成功${NC}"
                echo -e "${CYAN}    ${pr_url}${NC}"
            elif [[ "$pr_url" == "PR_EXISTS" ]] && [[ "$pr_exit_code" -eq 0 ]]; then
                # PR 已存在但无法获取 URL，简单提示
                pr_status_names+=("$name")
                pr_status_values+=("PR 已存在")
                ((success_count++))
                echo -e "${GREEN}  ${CHECK_MARK} PR 已存在${NC}"
            elif echo "$pr_url" | grep -q "可能导致冲突" || echo "$pr_error_output" | grep -q "可能导致冲突"; then
                pr_status_names+=("$name")
                pr_status_values+=("需要解决冲突")
                echo -e "${RED}  ${CROSS_MARK} 需要解决冲突（见上方提示）${NC}"
            else
                pr_status_names+=("$name")
                pr_status_values+=("创建失败")
                # 如果错误输出为空，说明可能是其他问题，显示通用错误信息
                if [[ -z "$pr_error_output" ]] && [[ $pr_exit_code -ne 0 ]]; then
                    echo -e "${RED}  ${CROSS_MARK} PR 创建失败（退出码: ${pr_exit_code}）${NC}"
                    echo -e "${YELLOW}  提示: 请检查网络连接、GitHub token 权限和分支状态${NC}"
                else
                    echo -e "${RED}  ${CROSS_MARK} PR 创建失败（见上方错误信息）${NC}"
                fi
            fi
        fi
        echo ""
    done
    
    # 第二遍：更新 PR 描述，添加关联链接
    if [[ ${#pr_urls_names[@]} -gt 1 ]]; then
        echo -e "${BLUE}更新 PR 描述，添加关联链接...${NC}"
        echo ""
        
        for i in "${!pr_urls_names[@]}"; do
            local repo_name="${pr_urls_names[$i]}"
            local pr_url="${pr_urls_values[$i]}"
            
            # 构建关联链接描述
            local related_links="## 相关 PR"$'\n'$'\n'
            for j in "${!pr_urls_names[@]}"; do
                local other_repo="${pr_urls_names[$j]}"
                local other_url="${pr_urls_values[$j]}"
                if [[ "$other_repo" != "$repo_name" ]]; then
                    related_links="${related_links}- [${other_repo}](${other_url})"$'\n'
                fi
            done
            
            # 找到对应的仓库信息
            for repo_info in "${repos_array[@]}"; do
                IFS='|' read -r name path url <<< "$repo_info"
                if [[ "$name" == "$repo_name" ]]; then
                    local repo_path="${PROJECT_ROOT}/${path}"
                    
                    # 获取原始描述
                    local original_description="${description:-}"
                    local new_description="${original_description}"$'\n'$'\n'"${related_links}"
                    
                    # 更新 PR 描述
                    if update_pr_description "$repo_path" "$repo_info" "$pr_url" "$new_description" "$github_token"; then
                        echo -e "${GREEN}${CHECK_MARK} 已更新 ${repo_name} 的 PR 描述${NC}"
                    else
                        echo -e "${BOLD_YELLOW}警告: 更新 ${repo_name} 的 PR 描述失败${NC}"
                    fi
                    break
                fi
            done
        done
        echo ""
    fi
    
    # 汇总结果 - 输出表格
    echo ""
    echo -e "${BLUE}========================================${NC}"
    echo -e "${BLUE}  PR 创建结果汇总${NC}"
    echo -e "${BLUE}========================================${NC}"
    echo ""
    
    # 输出表格
    printf "%-30s %s\n" "仓库" "状态/PR 链接"
    echo "────────────────────────────────────────────────────────────────"
    
    # 先输出所有仓库的状态
    for repo_info in "${repos_array[@]}"; do
        IFS='|' read -r name path url <<< "$repo_info"
        
        # 查找这个仓库的状态
        local found=false
        local status=""
        for i in "${!pr_status_names[@]}"; do
            if [[ "${pr_status_names[$i]}" == "$name" ]]; then
                status="${pr_status_values[$i]}"
                found=true
                break
            fi
        done
        
        if [[ "$found" == true ]]; then
            if [[ "$status" == "无改动" ]] || [[ "$status" == "无代码变更" ]]; then
                printf "%-30s %s\n" "$name:" "无代码变更"
            elif [[ "$status" == "需要先推送" ]]; then
                printf "%-30s %s\n" "$name:" "需要先推送（本地有未推送的提交）"
            elif [[ "$status" == "创建失败" ]] || [[ "$status" == "路径不存在" ]] || [[ "$status" == "无法获取分支" ]]; then
                printf "%-30s %s\n" "$name:" "$status"
            else
                # 这是 PR URL
                printf "%-30s %s\n" "$name:" "$status"
            fi
        else
            printf "%-30s %s\n" "$name:" "未处理"
        fi
    done
    
    echo ""
    echo -e "${BLUE}========================================${NC}"
    if [[ $success_count -gt 0 ]]; then
        echo -e "${GREEN}${CHECK_MARK} 成功创建 ${success_count} 个 PR${NC}"
    fi
    if [[ $skipped_count -gt 0 ]]; then
        echo -e "${YELLOW}⏭  跳过 ${skipped_count} 个仓库（无改动）${NC}"
    fi
    if [[ $success_count -eq 0 ]] && [[ $skipped_count -eq 0 ]]; then
        echo -e "${YELLOW}没有创建任何 PR${NC}"
    fi
    echo -e "${BLUE}========================================${NC}"
    return 0
}

# 主函数
main() {
    # 处理特殊命令
    case "${1:-}" in
        list)
            list_repositories
            ;;
        init)
            init_config
            ;;
        config)
            edit_config
            ;;
        clone)
            # mt clone 命令：克隆 Plaud-App 仓库并初始化子模块
            local target_dir="${2:-Plaud-App}"
            local repo_url="git@github.com:Plaud-AI/Plaud-App.git"
            
            echo -e "${BLUE}========================================${NC}"
            echo -e "${BLUE}  开始克隆 Plaud-App 仓库${NC}"
            echo -e "${BLUE}========================================${NC}"
            echo ""
            echo -e "${CYAN}仓库地址: ${repo_url}${NC}"
            echo -e "${CYAN}目标目录: ${target_dir}${NC}"
            echo ""
            
            # 检查目标目录是否已存在
            if [[ -d "$target_dir" ]]; then
                echo -e "${BOLD_YELLOW}警告: 目录 ${target_dir} 已存在${NC}"
                echo -e "${YELLOW}是否要继续？(y/N)${NC}"
                read -r response
                if [[ ! "$response" =~ ^[Yy]$ ]]; then
                    echo -e "${YELLOW}已取消${NC}"
                    exit 0
                fi
            fi
            
            # 执行 git clone
            echo -e "${BLUE}[1/3] 克隆主仓库...${NC}"
            print_command "$(pwd)" git clone "$repo_url" "$target_dir"
            
            if ! git clone "$repo_url" "$target_dir" 2>&1; then
                echo -e "${BOLD_RED}${CROSS_MARK} 克隆失败${NC}"
                exit 1
            fi
            
            echo ""
            echo -e "${GREEN}${CHECK_MARK} 主仓库克隆成功${NC}"
            echo ""
            
            # 进入目录并初始化子模块
            echo -e "${BLUE}[2/3] 初始化子模块...${NC}"
            echo -e "${CYAN}执行: git submodule update --init --recursive${NC}"
            echo ""
            
            # 执行子模块初始化，并显示输出
            local submodule_output
            if ! submodule_output=$(cd "$target_dir" && git submodule update --init --recursive 2>&1); then
                echo -e "${BOLD_RED}${CROSS_MARK} 子模块初始化失败${NC}"
                echo -e "${YELLOW}输出:${NC}"
                echo "$submodule_output" | sed 's/^/  /'
                echo ""
                echo -e "${BOLD_YELLOW}警告: 主仓库已克隆成功，但子模块初始化失败${NC}"
                echo -e "${YELLOW}你可以稍后手动执行: cd ${target_dir} && git submodule update --init --recursive${NC}"
                exit 1
            fi
            
            # 显示子模块初始化的输出（如果有）
            if [[ -n "$submodule_output" ]]; then
                echo "$submodule_output" | sed 's/^/  /'
            fi
            
            echo ""
            echo -e "${GREEN}${CHECK_MARK} 子模块初始化成功${NC}"
            echo ""
            
            # 克隆 Android 子仓库（需要手动 clone）
            echo -e "${BLUE}[3/3] 克隆 Android 子仓库...${NC}"
            local android_subrepo_path="${target_dir}/plaud-android/nicebuildSDK"
            local android_subrepo_url="git@github.com:Plaud-AI/ble-sdk-android.git"
            
            # 检查父目录是否存在
            if [[ ! -d "${target_dir}/plaud-android" ]]; then
                echo -e "${BOLD_YELLOW}警告: plaud-android 目录不存在，跳过 Android 子仓库克隆${NC}"
            elif [[ -d "$android_subrepo_path" ]]; then
                echo -e "${YELLOW}  ⏭  跳过: nicebuildSDK 目录已存在${NC}"
            else
                echo -e "${CYAN}执行: git clone ${android_subrepo_url} ${android_subrepo_path}${NC}"
                echo ""
                
                if ! (cd "${target_dir}/plaud-android" && git clone "$android_subrepo_url" "nicebuildSDK" 2>&1); then
                    echo -e "${BOLD_YELLOW}警告: Android 子仓库克隆失败${NC}"
                    echo -e "${YELLOW}你可以稍后手动执行: cd ${target_dir}/plaud-android && git clone ${android_subrepo_url} nicebuildSDK${NC}"
                else
                    echo ""
                    echo -e "${GREEN}${CHECK_MARK} Android 子仓库克隆成功${NC}"
                fi
            fi
            
            echo ""
            echo -e "${BLUE}========================================${NC}"
            echo -e "${GREEN}${CHECK_MARK} 克隆完成！${NC}"
            echo -e "${BLUE}========================================${NC}"
            echo ""
            echo -e "${CYAN}下一步:${NC}"
            echo -e "${CYAN}  cd ${target_dir}${NC}"
            echo -e "${CYAN}  mt list  # 查看所有仓库${NC}"
            echo ""
            ;;
        set-github-token)
            if [[ -z "${2:-}" ]]; then
                echo -e "${BOLD_RED}错误: 请提供 GitHub token${NC}"
                echo -e "${YELLOW}用法: mt set-github-token <your_token>${NC}"
                echo -e "${CYAN}获取 token: https://github.com/settings/tokens${NC}"
                exit 1
            fi
            shift
            set_github_token "$1"
            ;;
        upgrade)
            upgrade_mt
            ;;
        delete)
            shift
            delete_branches "$@"
            ;;
        clean)
            clean_cache
            ;;
        prebuild)
            prebuild
            ;;
        build)
            # 如果没有指定市场，默认为 global
            if [[ -z "${2:-}" ]] || [[ "${2}" =~ ^- ]]; then
                # 没有指定市场，使用默认 global
                shift
                build_android "global" "$@"
            else
                # 指定了市场
                shift
                build_android "$@"
            fi
            ;;
        build:check)
            shift
            build_check "$@"
            ;;
        build:ios)
            shift
            build_ios "$@"
            ;;
        install)
            # 检查是否是 iOS 安装
            if [[ "${2:-}" == "ios" ]]; then
                shift 2
                install_ios "$@"
            else
                # Android 安装（如果没有指定市场，默认为 global）
                if [[ -z "${2:-}" ]] || [[ "${2}" =~ ^- ]]; then
                    # 没有指定市场，使用默认 global
                    shift
                    install_android "global" "$@"
                else
                    # 指定了市场
                    shift
                    install_android "$@"
                fi
            fi
            ;;
        install:ios)
            shift
            install_ios "$@"
            ;;
        go)
            # 如果没有指定市场，默认为 global
            if [[ -z "${2:-}" ]] || [[ "${2}" =~ ^- ]]; then
                # 没有指定市场，使用默认 global
                shift
                go_android "global" "$@"
            else
                # 指定了市场
                shift
                go_android "$@"
            fi
            ;;
        pr)
            shift
            local target_branch="main"
            local title=""
            local description=""
            
            # 解析参数
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -b|--b|--base)
                        if [[ -z "${2:-}" ]]; then
                            echo -e "${BOLD_RED}错误: --base 需要指定目标分支${NC}"
                            exit 1
                        fi
                        target_branch="$2"
                        shift 2
                        ;;
                    -t|--t|--title)
                        if [[ -z "${2:-}" ]]; then
                            echo -e "${BOLD_RED}错误: --title 需要指定 PR 标题${NC}"
                            exit 1
                        fi
                        title="$2"
                        shift 2
                        ;;
                    -d|--d|--description)
                        if [[ -z "${2:-}" ]]; then
                            echo -e "${BOLD_RED}错误: --description 需要指定 PR 描述${NC}"
                            exit 1
                        fi
                        description="$2"
                        shift 2
                        ;;
                    *)
                        echo -e "${BOLD_RED}错误: 未知参数: $1${NC}"
                        echo -e "${YELLOW}用法: mt pr [-b <branch>] [-t <title>] [-d <description>]${NC}"
                        exit 1
                        ;;
                esac
            done
            
            if ! create_prs "$target_branch" "$title" "$description"; then
                exit 1
            fi
            ;;
        plaud)
            shift
            case "${1:-}" in
                version)
                    shift
                    mt_plaud_version "$@"
                    ;;
                log)
                    shift
                    case "${1:-}" in
                        sync)
                            shift
                            mt_plaud_log_sync "$@"
                            ;;
                        clean)
                            shift
                            mt_plaud_log_clean "$@"
                            ;;
                        time-diff)
                            shift
                            mt_plaud_log_time_diff "$@"
                            ;;
                        *)
                            echo -e "${BOLD_RED}错误: 未知的 plaud log 子命令: ${1:-}${NC}"
                            echo -e "${YELLOW}用法:${NC}"
                            echo -e "${CYAN}  mt plaud log sync <日志文件路径>        分析日志中的同步操作${NC}"
                            echo -e "${CYAN}  mt plaud log clean <日志文件路径>       清理网络日志格式${NC}"
                            echo -e "${CYAN}  mt plaud log time-diff <日志文件路径>   分析同步时间差${NC}"
                            exit 1
                            ;;
                    esac
                    ;;
                check)
                    shift
                    case "${1:-}" in
                        opus)
                            shift
                            mt_plaud_check_opus "$@"
                            ;;
                        *)
                            echo -e "${BOLD_RED}错误: 未知的 plaud check 子命令: ${1:-}${NC}"
                            echo -e "${YELLOW}用法: mt plaud check opus <文件路径>${NC}"
                            exit 1
                            ;;
                    esac
                    ;;
                copy)
                    shift
                    mt_plaud_copy "$@"
                    ;;
                decrypt)
                    shift
                    mt_plaud_decrypt "$@"
                    ;;
                *)
                    echo -e "${BOLD_RED}错误: 未知的 plaud 子命令: ${1:-}${NC}"
                    echo -e "${YELLOW}用法:${NC}"
                    echo -e "${CYAN}  mt plaud version -c <code> [-f]    版本号转换：versionCode → 版本字符串${NC}"
                    echo -e "${CYAN}  mt plaud version -s <string>         版本号转换：版本字符串 → versionCode${NC}"
                    echo -e "${CYAN}  mt plaud log sync <file>            分析日志中的同步操作记录${NC}"
                    echo -e "${CYAN}  mt plaud log clean <file>            清理网络日志格式${NC}"
                    echo -e "${CYAN}  mt plaud log time-diff <file>        分析同步时间差（支持 --min-diff 过滤）${NC}"
                    echo -e "${CYAN}  mt plaud check opus <file>           检查 Opus 文件格式${NC}"
                    echo -e "${CYAN}  mt plaud copy <file> [count]        批量复制文件（文件名自动递增）${NC}"
                    echo -e "${CYAN}  mt plaud decrypt <file> [-o <dir>]   解密 Plaud 加密文件${NC}"
                    exit 1
                    ;;
            esac
            ;;
        help|--help|-h)
            show_help
            ;;
        --version|-v)
            echo "mt version ${VERSION}"
            ;;
        "")
            show_help
            ;;
        *)
            # 检查是否是支持的 Git 命令
            local supported_git_commands=(
                "add" "am" "apply" "archive" "bisect" "blame" "branch" "bundle" "checkout"
                "cherry-pick" "citool" "clean" "clone" "commit" "config" "describe" "diff"
                "fetch" "format-patch" "gc" "grep" "gui" "init" "log" "merge" "mv" "notes"
                "pull" "push" "rebase" "remote" "reset" "revert" "rm" "show" "stash"
                "status" "submodule" "switch" "tag" "worktree"
            )
            
            local first_arg="${1}"
            local is_supported=false
            local actual_cmd=""
            local additional_args=()
            
            # 先检查是否是 Git 命令缩写（包括带参数的缩写）
            case "$first_arg" in
                # 基础命令缩写
                co)
                    actual_cmd="checkout"
                    is_supported=true
                    ;;
                cob)
                    # checkout -b
                    actual_cmd="checkout"
                    additional_args=("-b")
                    is_supported=true
                    ;;
                br)
                    actual_cmd="branch"
                    is_supported=true
                    ;;
                bra)
                    # branch -a
                    actual_cmd="branch"
                    additional_args=("-a")
                    is_supported=true
                    ;;
                ci|cm)
                    actual_cmd="commit"
                    is_supported=true
                    ;;
                cim)
                    # commit -m
                    actual_cmd="commit"
                    additional_args=("-m")
                    is_supported=true
                    ;;
                ciam)
                    # commit -am
                    actual_cmd="commit"
                    additional_args=("-am")
                    is_supported=true
                    ;;
                cane)
                    # commit --amend --no-edit
                    actual_cmd="commit"
                    additional_args=("--amend" "--no-edit")
                    is_supported=true
                    ;;
                st)
                    actual_cmd="status"
                    is_supported=true
                    ;;
                ps|ph)
                    actual_cmd="push"
                    is_supported=true
                    ;;
                phf)
                    # push -f
                    actual_cmd="push"
                    additional_args=("-f")
                    is_supported=true
                    ;;
                pl)
                    actual_cmd="pull"
                    is_supported=true
                    ;;
                plro)
                    # pull --rebase origin
                    actual_cmd="pull"
                    additional_args=("--rebase" "origin")
                    is_supported=true
                    ;;
                m)
                    actual_cmd="merge"
                    is_supported=true
                    ;;
                rb|rbi)
                    # rebase 或 rebase -i
                    actual_cmd="rebase"
                    if [[ "$first_arg" == "rbi" ]]; then
                        additional_args=("-i")
                    fi
                    is_supported=true
                    ;;
                rba)
                    # rebase --abort
                    actual_cmd="rebase"
                    additional_args=("--abort")
                    is_supported=true
                    ;;
                rbc)
                    # rebase --continue
                    actual_cmd="rebase"
                    additional_args=("--continue")
                    is_supported=true
                    ;;
                sa|shs|sha|shp|shd)
                    # stash 相关命令
                    actual_cmd="stash"
                    case "$first_arg" in
                        shs)
                            additional_args=("save")
                            ;;
                        sha)
                            additional_args=("apply")
                            ;;
                        shp)
                            additional_args=("pop")
                            ;;
                        shd)
                            additional_args=("drop")
                            ;;
                    esac
                    is_supported=true
                    ;;
                sw)
                    actual_cmd="switch"
                    is_supported=true
                    ;;
                cp)
                    actual_cmd="cherry-pick"
                    is_supported=true
                    ;;
                cpa)
                    # cherry-pick --abort
                    actual_cmd="cherry-pick"
                    additional_args=("--abort")
                    is_supported=true
                    ;;
                cpc)
                    # cherry-pick --continue
                    actual_cmd="cherry-pick"
                    additional_args=("--continue")
                    is_supported=true
                    ;;
                fe|ft)
                    actual_cmd="fetch"
                    is_supported=true
                    ;;
                di)
                    actual_cmd="diff"
                    is_supported=true
                    ;;
                lo)
                    actual_cmd="log"
                    is_supported=true
                    ;;
                rs|rth|rts)
                    # reset 相关命令
                    actual_cmd="reset"
                    case "$first_arg" in
                        rth)
                            additional_args=("--hard")
                            ;;
                        rts)
                            additional_args=("--soft")
                            ;;
                    esac
                    is_supported=true
                    ;;
                rv)
                    actual_cmd="revert"
                    is_supported=true
                    ;;
                sh)
                    actual_cmd="show"
                    is_supported=true
                    ;;
                ta)
                    actual_cmd="tag"
                    is_supported=true
                    ;;
                ad)
                    actual_cmd="add"
                    is_supported=true
                    ;;
                *)
                    # 检查是否是完整的 Git 命令
                    for cmd in "${supported_git_commands[@]}"; do
                        if [[ "$first_arg" == "$cmd" ]]; then
                            actual_cmd="$first_arg"
                            is_supported=true
                            break
                        fi
                    done
                    ;;
            esac
            
            if [[ "$is_supported" == "true" ]]; then
                # 如果有额外的参数需要插入，重新构建参数列表
                if [[ ${#additional_args[@]} -gt 0 ]]; then
                    set -- "$actual_cmd" "${additional_args[@]}" "${@:2}"
                elif [[ "$actual_cmd" != "$first_arg" ]]; then
                    # 只是简单的命令替换
                    set -- "$actual_cmd" "${@:2}"
                fi
                # 执行 Git 命令
                run_command "$@"
            else
                # 不支持的命令，显示错误提示
                echo -e "${BOLD_RED}错误: 不支持的命令: ${first_arg}${NC}"
                echo ""
                echo -e "${YELLOW}支持的命令:${NC}"
                echo -e "${CYAN}  工具命令: list, init, config, set-github-token, delete, clean, upgrade${NC}"
                echo -e "${CYAN}  构建命令: prebuild, build, install, install:ios, build:check, build:ios${NC}"
                echo -e "${CYAN}  Plaud 工具: plaud${NC}"
                echo -e "${CYAN}  PR 命令: pr${NC}"
                echo -e "${CYAN}  Git 命令: ${supported_git_commands[*]}${NC}"
                echo -e "${CYAN}  Git 缩写: co/cob(checkout), br/bra(branch), ci/cm/cim/ciam/cane(commit), st(status), ps/ph/phf(push), pl/plro(pull), m(merge), rb/rbi/rba/rbc(rebase), sa/shs/sha/shp/shd(stash), sw(switch), cp/cpa/cpc(cherry-pick), fe/ft(fetch), di(diff), lo(log), rs/rth/rts(reset), rv(revert), sh(show), ta(tag), ad(add)${NC}"
                echo ""
                echo -e "${YELLOW}使用 \"mt help\" 查看详细帮助信息${NC}"
                exit 1
            fi
            ;;
    esac
}

# 执行主函数
main "$@"

