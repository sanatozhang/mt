#!/bin/bash
#
# MT - Multi-repo Tool
# 多仓库 Git 管理工具
#

set -euo pipefail

resolve_script_path() {
    local script_path="$1"

    while [[ -L "$script_path" ]]; do
        local link_target
        link_target=$(readlink "$script_path")
        if [[ "$link_target" = /* ]]; then
            script_path="$link_target"
        else
            script_path="$(cd "$(dirname "$script_path")" && cd "$(dirname "$link_target")" && pwd)/$(basename "$link_target")"
        fi
    done

    if [[ "$script_path" != /* ]]; then
        script_path="$(cd "$(dirname "$script_path")" && pwd)/$(basename "$script_path")"
    fi

    echo "$script_path"
}

SCRIPT_PATH="$(resolve_script_path "${BASH_SOURCE[0]:-$0}")"
SCRIPT_BIN_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

supports_color() {
    if [[ ! -t 1 ]]; then
        return 1
    fi

    case "${TERM:-}" in
        xterm*|rxvt*|screen*|tmux*|linux|vt100|dumb)
            if [[ -n "${NO_COLOR:-}" ]]; then
                return 1
            fi
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

USE_COLOR=false
if supports_color; then
    USE_COLOR=true
fi

if [[ "$USE_COLOR" == "true" ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    NC='\033[0m'

    BOLD_RED='\033[1;31m'
    BOLD_GREEN='\033[1;32m'
    BOLD_YELLOW='\033[1;33m'
    BOLD_BLUE='\033[1;34m'
    BOLD_CYAN='\033[1;36m'

    BRIGHT_CYAN='\033[0;96m'
    BRIGHT_BLUE='\033[0;94m'
    DIM='\033[2m'
    GRAY='\033[0;90m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    CYAN=''
    NC=''
    BOLD_RED=''
    BOLD_GREEN=''
    BOLD_YELLOW=''
    BOLD_BLUE=''
    BOLD_CYAN=''
    BRIGHT_CYAN=''
    BRIGHT_BLUE=''
    DIM=''
    GRAY=''
fi

